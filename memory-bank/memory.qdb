  "system_patterns": [
    {
      "name": "Anchor-Guided Search",
      "description": "Core engine uses an anchor table (`keystone_anchor_table_t`) to memorize lookups and bound searches, followed by 128-bit interpolation and runtime-detected SIMD logic (AVX512, AVX2, AMX, etc.) for local chunk resolution."
    },
    {
      "name": "Adaptive Backend Calibration",
      "description": "Evaluates query shape (sorted/dense) using `keystone_detect_auto_query_shape()` and tests viable backends at runtime to select and cache the fastest execution path."
    },
    {
      "name": "Native System Tuning (NST)",
      "description": "An autonomous tuning layer (`nst_*`) that tracks memory topology, DRAM row-buffer locality, aligns cache-lines, profiles prefetch hits to adapt distances, and provides BTB seeds to warm up branch predictors for tight search loops."
    },
    {
      "name": "DSMIL Telemetry & Wrapper",
      "description": "Wrappers (`dsmil_keystone_wrapper.c`) bridge domain events (logs, security events) by extracting targets into primitive `int64_t` contiguous arrays for zero-overhead vector querying."
    },
    {
      "name": "Streaming Archive Ingestion",
      "description": "Integrates `libarchive` (`keystone_tar_zst.c`) for streaming decompression of `tar.zst` files without full inflation. Builds a member offset index via hash tables and bloom filters for fast lookups."
    },
    {
      "name": "Fortran Batch Optimization",
      "description": "Optional high-throughput Fortran module (`keystone_batch.f90`) featuring merge-walk and OpenMP binary search paths, selected when the C calibration layer detects strictly sorted, dense query batches."
    }
