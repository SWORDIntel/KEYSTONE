digraph G {
graph [rankdir=LR, bgcolor="#1A1A1A", fontcolor="#E0E0E0", fontname="DejaVu Sans", fontsize=22, pad=0.4, nodesep=0.35, ranksep=0.6, labelloc=t, label="KEYSTONE | Historical NST paths - removed 2026-09-12
